set(prefix "@CMAKE_CURRENT_BINARY_DIR@/test-install")
file(REMOVE_RECURSE "${prefix}")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
    --prefix "${prefix}" --config "${CONFIG}" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "install failed")
endif()
set(package "${prefix}/@TPATHEXP_PACKAGE_DIR@")
set(shared "${package}/@CMAKE_SHARED_LIBRARY_PREFIX@tpathexp@CMAKE_SHARED_LIBRARY_SUFFIX@")
set(static "${prefix}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@tpathexp@CMAKE_STATIC_LIBRARY_SUFFIX@")
if(@BUILD_SHARED_LIBS@)
    if(NOT EXISTS "${shared}" OR EXISTS "${static}")
        message(FATAL_ERROR "shared install must contain only the shared library")
    endif()
else()
    if(NOT EXISTS "${static}" OR EXISTS "${shared}")
        message(FATAL_ERROR "static install must contain only the static archive")
    endif()
endif()
if(NOT EXISTS "${package}/pkgIndex.tcl" OR EXISTS "${package}/tpathexp.tcl")
    message(FATAL_ERROR "install must contain a native package index without a Tcl implementation")
endif()
file(READ "${package}/pkgIndex.tcl" index)
if(NOT @BUILD_SHARED_LIBS@ AND NOT index MATCHES "load \\{\\} Tpathexp")
    message(FATAL_ERROR "static package index must load the registered static package")
endif()
foreach(header tpathexp.h path_regexp.h router.h)
    if(NOT EXISTS "${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/tpathexp/${header}")
        message(FATAL_ERROR "missing public header ${header}")
    endif()
endforeach()
